rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny for unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['playerName', 'score', 'distance', 'examPapers', 'constitutions', 'votes', 'characterName', 'civicRank', 'createdAt'])
        && data.keys().hasOnly(['playerName', 'score', 'distance', 'examPapers', 'constitutions', 'votes', 'characterName', 'civicRank', 'createdAt'])
        && data.playerName is string
        && data.playerName.size() >= 2
        && data.playerName.size() <= 32
        && data.score is int
        && data.score >= 0
        && data.score <= 10000000
        && data.distance is int
        && data.distance >= 0
        && data.examPapers is int
        && data.examPapers >= 0
        && data.constitutions is int
        && data.constitutions >= 0
        && data.votes is int
        && data.votes >= 0
        && data.characterName is string
        && data.characterName.size() <= 48
        && data.civicRank is string
        && data.civicRank.size() <= 48
        && data.createdAt is string
        && data.createdAt.size() <= 64;
    }

    // Global Leaderboard Collection
    match /leaderboard/{entryId} {
      // Anyone can read top scores
      allow list, get: if true;

      // Allow creating a valid leaderboard score submission
      allow create: if isValidId(entryId) && isValidLeaderboardEntry(request.resource.data);

      // Scores are immutable once recorded
      allow update, delete: if false;
    }
  }
}
